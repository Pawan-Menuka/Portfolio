# .env.example
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated exact origins allowed to make credentialed requests.
FRONTEND_ORIGINS=http://localhost:5173
# Optional, off by default. Only set this for a platform with rotating
# preview URLs (e.g. Vercel) — anchor at both ends and escape literal dots,
# or it will match more than intended. Example for a Vercel team "myteam"
# and project "portfolio":
# PREVIEW_ORIGIN_REGEX=^https:\/\/portfolio-[a-z0-9]+-myteam\.vercel\.app$
PREVIEW_ORIGIN_REGEX=
ADMIN_EMAIL=
ADMIN_PASSWORD=
VERCEL_DEPLOY_HOOK_URL=
GH_TOKEN=
# Optional. If either is unset, contact-form notifications are skipped —
# messages are still stored, the visitor still sees success either way.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
# Optional, defaults to a Resend sandbox address if unset.
CONTACT_NOTIFY_FROM=
